# =============================================================================
# Environment variables — NAMES AND PLACEHOLDERS ONLY.
#
# Copy to `.env` and fill in real values locally. `.env` is gitignored and must
# never be committed: a secret committed once stays in git history permanently.
# =============================================================================

# -----------------------------------------------------------------------------
# Database — Neon PostgreSQL (ADR-0002, ADR-0008, D-A3a)
#
# Two connection strings, and using the wrong one is a real production fault:
#
#   DATABASE_URL  pooled   (…-pooler.…)  → application runtime
#   DIRECT_URL    direct   (no -pooler)  → migrations only
#
# Migrations need a direct connection because they take advisory locks and run
# DDL, which a transaction pooler cannot carry. Runtime needs the pooler because
# serverless functions open far more connections than Postgres will accept.
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://[USER]:[PASSWORD]@[PROJECT]-pooler.[REGION].aws.neon.tech/[DATABASE]?sslmode=require"
DIRECT_URL="postgresql://[USER]:[PASSWORD]@[PROJECT].[REGION].aws.neon.tech/[DATABASE]?sslmode=require"

# -----------------------------------------------------------------------------
# Authentication — Auth.js (ADR-0004)
#
# Generate a secret with:  npx auth secret
# or:                      openssl rand -base64 32
# -----------------------------------------------------------------------------
AUTH_SECRET="[GENERATE_A_32_BYTE_RANDOM_SECRET]"

# Canonical origin. Auth.js uses this to build callback URLs; getting it wrong
# breaks sign-in in production only, which is a bad place to discover it.
AUTH_URL="http://localhost:3000"

# Set to `true` only when running behind a proxy that terminates TLS (Vercel does).
AUTH_TRUST_HOST="true"

# -----------------------------------------------------------------------------
# Media — Cloudinary (ADR-0005)
#
# CLOUDINARY_API_SECRET is a server-only secret. It signs upload credentials and
# must never be exposed to the browser or prefixed with NEXT_PUBLIC_.
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="[CLOUDINARY_CLOUD_NAME]"
CLOUDINARY_API_KEY="[CLOUDINARY_API_KEY]"
CLOUDINARY_API_SECRET="[CLOUDINARY_API_SECRET]"

# The cloud name is not a secret — the browser needs it to build image URLs.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="[CLOUDINARY_CLOUD_NAME]"

# Upload folder, so school media is namespaced within the Cloudinary account.
CLOUDINARY_UPLOAD_FOLDER="school"

# -----------------------------------------------------------------------------
# Site
#
# NEXT_PUBLIC_SITE_URL is the canonical absolute origin. It is used for canonical
# tags, sitemap entries, Open Graph URLs and JSON-LD. A wrong value here silently
# damages SEO across every page (25_SEO_STRATEGY).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Guard for the manual revalidation endpoint (/api/revalidate). Without it the
# endpoint is an unauthenticated cache-busting lever for anyone who finds it.
REVALIDATE_SECRET="[GENERATE_A_RANDOM_SECRET]"

# -----------------------------------------------------------------------------
# Email — provider NOT YET SELECTED (OD-014, open decision)
#
# Enquiry notifications need a transactional email provider. The vendor is an
# unresolved owner decision, so these names are provisional and the email module
# is written against a provider-agnostic interface.
# -----------------------------------------------------------------------------
EMAIL_FROM="[NOREPLY@SCHOOL_DOMAIN]"
EMAIL_TO_ADMISSIONS="[ADMISSIONS@SCHOOL_DOMAIN]"
EMAIL_PROVIDER_API_KEY="[EMAIL_PROVIDER_API_KEY]"

# -----------------------------------------------------------------------------
# Seeding — development only.
#
# Used by `npm run db:seed` to create the first SUPER_ADMIN. There is no public
# registration and no default password baked into the codebase, so the first
# account has to come from somewhere; this is that somewhere.
#
# NEVER set these in production. Create production accounts through the admin UI.
# -----------------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@example.test"
SEED_ADMIN_PASSWORD="[STRONG_LOCAL_DEV_PASSWORD]"
